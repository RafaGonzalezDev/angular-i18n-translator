# LLM API Configuration
# Copy this file to .env and fill in your real values. Never commit a real key.
# Version 2.0 tests/audit use local mocks: no live API calls or token spending.

# API key of your LLM provider (not stored in artifact/cache metadata)
LLM_API_KEY=your-api-key-here

# DeepSeek recipe configured for the audit; confirm model availability before use.
# Thinking is disabled via llm.requestExtra in i18n.config.json, not this file.
# This is not a live-provider performance or translation-quality certification.
LLM_MODEL=deepseek-v4-flash

# Base URL of the OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com
