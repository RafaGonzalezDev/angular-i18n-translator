# LLM API Configuration
# Copy this file to .env and fill in your real values.

# API key of your LLM provider
LLM_API_KEY=your-api-key-here

# Model identifier. For DeepSeek, use deepseek-v4-flash (fast and cheap)
# or deepseek-v4-pro. Note: DeepSeek models have thinking mode enabled by
# default; this project disables it via llm.requestExtra in i18n.config.json.
LLM_MODEL=deepseek-v4-flash

# Base URL of the OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com
